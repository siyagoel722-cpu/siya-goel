#include <stdio.h>
int main() {
    int a, b, x, y, remainder, gcd, lcm;
    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);
    x = a;
    y = b;
    // Find GCD using the Euclidean algorithm
    while (y != 0) {
        remainder = x % y;
        x = y;
        y = remainder;
    }
    gcd = x;
    lcm = (a * b) / gcd;
    printf("LCM of %d and %d = %d\n", a, b, lcm);
    return 0;
}
